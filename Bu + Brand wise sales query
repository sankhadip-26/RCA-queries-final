WITH date_range AS (
  SELECT
    DATE_TRUNC(CURRENT_DATE('Asia/Kolkata'), MONTH) AS start_date,
    DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 1 DAY) AS end_date
),

-- =====================================================
-- 1. BASE SALES DATA
-- =====================================================

base AS (
  SELECT
    DATE(oo.create_date, 'Asia/Kolkata') AS order_date,

    nt.division AS division,
    COALESCE(pb.name, 'NA') AS brand,
    nt.gender AS gender,

    SAFE_CAST(oi.quantity AS NUMERIC) AS quantity,
    SAFE_CAST(oi.sp AS NUMERIC) AS sp_num

  FROM `slikk-prod.slikkprodpublic.order_order` oo

  JOIN `slikk-prod.slikkprodpublic.order_orderitem` oi
    ON oo.id = oi.order_id

  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = oi.product_id

  JOIN `slikk-prod.slikkprodpublic.product_brand` pb
    ON pb.id = pp.brand_id

  JOIN `slikk-prod.slikksilver.product_tags` pt
    ON pt.product_id = pp.id

  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id

  CROSS JOIN date_range d

  WHERE
    oo.status NOT IN ('OPEN', 'FAILED')
    AND oo.delivery_type != 'EXCHANGE'

    AND DATE(oo.create_date, 'Asia/Kolkata')
      BETWEEN d.start_date AND d.end_date
),

-- =====================================================
-- 2. CATEGORY MAPPING
-- =====================================================

categorized AS (
  SELECT
    CASE
      WHEN UPPER(division) = 'APPAREL'
        AND LOWER(TRIM(gender)) IN ('men', 'mens', 'unisex', 'unsiex')
        THEN 'APPAREL MEN'

      WHEN UPPER(division) = 'APPAREL'
        AND LOWER(TRIM(gender)) IN ('women', 'womens')
        THEN 'APPAREL WOMEN'

      WHEN UPPER(division) = 'ETHNIC'
        AND LOWER(TRIM(gender)) IN ('men', 'mens', 'unisex', 'unsiex')
        THEN 'ETHNIC MEN'

      WHEN UPPER(division) = 'ETHNIC'
        AND LOWER(TRIM(gender)) IN ('women', 'womens')
        THEN 'ETHNIC WOMEN'

      WHEN UPPER(division) = 'FOOTWEAR'
        AND LOWER(TRIM(gender)) IN ('men', 'mens', 'unisex', 'unsiex')
        THEN 'FW MEN'

      WHEN UPPER(division) = 'FOOTWEAR'
        AND LOWER(TRIM(gender)) IN ('women', 'womens')
        THEN 'FW WOMEN'

      ELSE UPPER(division)
    END AS category,

    brand,
    quantity,
    sp_num

  FROM base
)

-- =====================================================
-- 3. CATEGORY + BRAND OUTPUT
-- =====================================================

SELECT
  category,
  brand,

  SUM(quantity) AS total_qty_sold,

  ROUND(
    SUM(sp_num * quantity),
    2
  ) AS total_gmv,

  ROUND(
    SAFE_DIVIDE(
      SUM(sp_num * quantity),
      SUM(quantity)
    ),
    2
  ) AS asp

FROM categorized

WHERE category IS NOT NULL

GROUP BY
  category,
  brand

ORDER BY
  category,
  total_gmv DESC;
